# ==============================================================================
# Plateforme Officielle de l'École Nationale Polytechnique (ENP)
# Configuration de l'environnement frontend (React / Vite / TypeScript)
# ==============================================================================

# Mode d'exécution des données :
# - "true"  : Active la simulation institutionnelle complète (mock mémoire isolé conforme aux DTO)
# - "false" : Connecte l'application au backend NestJS sous /api/v1 avec credentials
VITE_USE_MOCK=true

# Préfixe officiel de l'API backend
VITE_API_BASE_URL=/api/v1
