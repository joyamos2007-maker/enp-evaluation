# Exemple de configuration d'environnement pour le projet ENP
# Copier ce fichier vers .env avant le lancement local ou en production.

PORT=3000
NODE_ENV=development

# Base principale de l'application (rôle application)
DATABASE_URL=postgresql://app_user:app_password@127.0.0.1:5432/enp_evaluation

# Bases distinctes pour l'urne et les résultats ; elles doivent être différentes de DATABASE_URL
DATABASE_URL_BALLOT=postgresql://ballot_user:ballot_password@127.0.0.1:5432/enp_ballot
DATABASE_URL_RESULTS=postgresql://results_user:results_password@127.0.0.1:5432/enp_results

# Secrets JWT distincts : accès, rafraîchissement, vote
JWT_ACCESS_SECRET=remplacer-par-une-longue-valeur-aleatoire
JWT_REFRESH_SECRET=remplacer-par-une-autre-valeur-aleatoire
BALLOT_TOKEN_SECRET=remplacer-par-un-secret-distinct-et-complexe

# Sécurité HTTP / cookies
COOKIE_SECURE=false
SESSION_TTL_MINUTES=30
ACCESS_TOKEN_TTL_MINUTES=15

# URLs publiques
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173

# Règles de sécurité
# - Chaque URL de base doit être différente des autres
# - Chaque secret doit être distinct et suffisamment long (>= 32 caractères)
# - En production, COOKIE_SECURE doit être true et les cookies HttpOnly/SameSite restent stricts
# - En production, ALLOWED_ORIGINS doit contenir uniquement le domaine front autorisé
