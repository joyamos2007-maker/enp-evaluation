# Exemple de configuration d'environnement pour le projet ENP.
# Les trois connexions utilisent la meme base et des roles PostgreSQL distincts.

PORT=3000
NODE_ENV=development

# Connexions a la base logique enp_evaluation ; definir les mots de passe des roles
# app_main, ballot_app et results_app apres l'application des scripts SQL.
DATABASE_URL=postgresql://app_main:replace-app-main-password@127.0.0.1:5432/enp_evaluation
DATABASE_URL_BALLOT=postgresql://ballot_app:replace-ballot-password@127.0.0.1:5432/enp_evaluation
DATABASE_URL_RESULTS=postgresql://results_app:replace-results-password@127.0.0.1:5432/enp_evaluation

# Secrets JWT distincts : acces, rafraichissement, vote.
JWT_ACCESS_SECRET=remplacer-par-une-longue-valeur-aleatoire
JWT_REFRESH_SECRET=remplacer-par-une-autre-valeur-aleatoire
BALLOT_TOKEN_SECRET=remplacer-par-un-secret-distinct-et-complexe

# Courriels de securite (activation MFA e-mail et reinitialisation du mot de passe).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# MFA : secrets distincts a generer pour chaque environnement.
MFA_CHALLENGE_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
MFA_ENCRYPTION_KEY=remplacer-par-64-caracteres-hexadecimaux-aleatoires

# Securite HTTP / cookies.
COOKIE_SECURE=false
SESSION_TTL_MINUTES=30
ACCESS_TOKEN_TTL_MINUTES=15

# URLs publiques.
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173

# En production, utiliser COOKIE_SECURE=true et limiter ALLOWED_ORIGINS
# au domaine frontal exact. Ne jamais reutiliser ces valeurs d'exemple.
